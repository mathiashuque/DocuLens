# Server-only: base URL of the FastAPI backend. Never prefix this with
# NEXT_PUBLIC_ — the browser must never see it.
DOCULENS_API_BASE_URL=http://localhost:8000

# Server-only: the public frontend origin used to build absolute metadata
# URLs (canonical, sitemap, Open Graph, JSON-LD). Not a secret — it doesn't
# need NEXT_PUBLIC_ because browser JavaScript never reads it directly, only
# server-rendered metadata does. Defaults to http://localhost:3000 outside
# production; production deployments must set this explicitly or metadata
# generation fails rather than silently emitting a localhost URL.
DOCULENS_SITE_URL=http://localhost:3000

# Must match the API settings when public anonymous quotas are enabled.
PUBLIC_DEMO_MODE=false
# ANONYMOUS_SESSION_SECRET=
ANONYMOUS_SESSION_MAX_AGE_SECONDS=2592000
