# Server-only: base URL of the FastAPI backend. Never prefix this with
# NEXT_PUBLIC_ — the browser must never see it.
DOCULENS_API_BASE_URL=http://localhost:8000

# Must match the API settings when public anonymous quotas are enabled.
PUBLIC_DEMO_MODE=false
# ANONYMOUS_SESSION_SECRET=
ANONYMOUS_SESSION_MAX_AGE_SECONDS=2592000
