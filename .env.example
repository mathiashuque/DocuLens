# Add documented, non-secret configuration defaults as services are introduced.

# Maximum accepted PDF upload size, in megabytes.
MAX_UPLOAD_MB=10

# Maximum accepted PDF physical page count.
MAX_DOCUMENT_PAGES=40

# --- Docker Compose local development ---

# Host port the API is published on (container always listens on 8000).
API_HOST_PORT=8000

# PostgreSQL/pgvector credentials, local-development only. Compose assembles
# these into DATABASE_URL (the canonical connection setting the API reads),
# using the `db` service name for in-network discovery.
POSTGRES_DB=doculens
POSTGRES_USER=doculens
POSTGRES_PASSWORD=doculens_local_only

# Outside Compose (e.g. running the API or Alembic directly on the host),
# set DATABASE_URL explicitly instead. Never commit a real value.
# DATABASE_URL=postgresql+asyncpg://doculens:doculens_local_only@localhost:5432/doculens

# --- Document classification ---

# Required to enable POST /api/documents/{id}/classification; without it the
# endpoint returns 503. Never commit a real value.
# OPENAI_API_KEY=

# Structured-output-capable model identifier. No implicit "latest" default.
CLASSIFICATION_MODEL=gpt-4o-mini

# Below this confidence, a non-generic candidate is routed to `generic`.
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.65

# --- Generic document analysis ---

# Reuses OPENAI_API_KEY above. Required to enable
# POST /api/documents/{id}/analysis; without it the endpoint returns 503.
# Structured-output-capable model identifier. No implicit "latest" default.
ANALYSIS_MODEL=gpt-4o-mini

# Character budget for the extraction context built from persisted pages.
ANALYSIS_BUDGET_CHARS=12000

# --- Retrieval indexing and search ---

# Reuses OPENAI_API_KEY above. Required to enable
# POST /api/documents/{id}/index and POST /api/documents/{id}/search;
# without it, indexing/search return 503. Never commit a real value.

# Embedding model identifier. Its output dimension must match
# EMBEDDING_DIMENSION and the fixed-dimension vector column created by
# migration 0007; changing either requires a new migration and an explicit
# reindex, never a runtime-only change.
EMBEDDING_MODEL=text-embedding-3-small

# Must match the configured model's actual output dimension.
EMBEDDING_DIMENSION=1536

# Maximum chunk texts embedded in one provider call.
EMBEDDING_MAX_BATCH_SIZE=96

# Maximum accepted search query length, in characters.
EMBEDDING_MAX_QUERY_CHARS=2000

# Maximum accepted `top_k` for search.
EMBEDDING_MAX_TOP_K=20
